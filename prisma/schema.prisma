// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Auth (NextAuth.js / Auth.js Prisma adapter shape) ──────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Billing: written only by the Stripe webhook, so it mirrors Stripe.
  plan                   Plan      @default(FREE)
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripeCurrentPeriodEnd DateTime?

  // Set once the first-run tour (list page + the seeded example Pursuit's
  // Brain Dump tab) has been finished or skipped — null means "still show
  // it". See src/lib/onboarding.ts.
  onboardedAt DateTime?

  // Home page blocks (lib/blocks.ts); null = defaults.
  homeBlocks Json?

  // What the welcome flow wrote as an example ({ topic, dumps, notes,
  // flashcards } ids), so "Quitar lo de ejemplo" can remove exactly that.
  sampleContent Json?

  // Profile: public @handle and the drawn avatar (lib/avatar.ts).
  // Codes: shows Retos (coding challenges) in the menu.
  codes Boolean @default(false)
  // Menu items switched on/off: { calendar?: bool, review?: bool }.
  nav   Json?
  username String? @unique
  avatar   Json?

  // "en" | "de" | "fr" | "es" (lib/i18n.ts).
  locale String @default("en")

  accounts Account[]
  sessions Session[]

  ownedPursuits Pursuit[]
  savedTests    SavedTest[]
  driveAgent    DriveAgent?
  driveSources  DriveSource[]
  driveChanges  DriveChange[]
  memberships   PursuitMember[]
  pursuitTags   PursuitTag[]
  sections      Section[]
  brainDumps    BrainDump[]
  organizeUsage OrganizeUsage[]

  classroomConnection GoogleClassroomConnection?
  calendarConnection  GoogleCalendarConnection?
  calendarEvents      CalendarEvent[]
  pushSubscriptions   PushSubscription[]
  sentNotifications   SentDeadlineNotification[]
  challenges          Challenge[]
  choiceVotes         ChoiceVote[]
  templates           UserTemplate[]
  expenses            Expense[]
  dateVotes           DateVote[]
  savings             Saving[]
  friendsSent         Friendship[] @relation("FriendFrom")
  friendsReceived     Friendship[] @relation("FriendTo")
}

enum Plan {
  FREE
  PRO
  TEAM
}

// Separate from the Google sign-in Account: a different consent (Classroom
// read access), and GitHub users can connect it too. Access tokens are
// refreshed on demand (lib/googleClassroom.ts).
model GoogleClassroomConnection {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  // The Google account it was connected with, so links to Classroom open
  // in that account (?authuser=) rather than whichever one is the default.
  email        String?
  createdAt    DateTime @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One per browser that enabled reminders (Web Push is per browser, not per account).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Dedupes the deadline cron: one push per user per assignment.
model SentDeadlineNotification {
  id           String   @id @default(cuid())
  courseWorkId String
  sentAt       DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseWorkId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Core app models ─────────────────────────────────────────────────────

enum PursuitStatus {
  ACTIVE
  PAUSED
  DONE
}

enum MemberRole {
  OWNER
  EDITOR
  VIEWER
}

model Pursuit {
  id            String        @id @default(cuid())
  title         String
  // Free-typed and optional, like Section.
  type          String?
  status        PursuitStatus @default(ACTIVE)
  // Sticky note on the subject ("current status, pending…"). Plain text.
  statusNote    String?
  artifactUrl   String?
  lastTouchedAt DateTime      @default(now())
  createdAt     DateTime      @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])
  // Which of its notebook's groups (Section.groups) it sits in; null = none.
  group     String?
  // The hidden folder that holds a notebook's loose pages (pages made right
  // in the notebook, without a folder). Never listed as a folder.
  loose     Boolean @default(false)

  // The linked Classroom course; the name is cached for display.
  classroomCourseId   String?
  classroomCourseName String?
  // Opt-in per subject: Classroom only makes sense for school subjects.
  classroomEnabled    Boolean @default(false)

  // Folder look and layout: cover pattern key, what its groups are called
  // ("Unidad", "Tema"…; null = "Unidad"), and its page blocks (lib/blocks.ts;
  // null = defaults for its notebook).
  cover      String?
  groupLabel String?
  blocks     Json?
  // Study tools (concept map, flashcards, review, challenges) for this
  // folder alone; null = whatever its notebook has.
  study      Boolean?

  // As a project (folders in notebooks without study tools): its dates,
  // shown on the notebook's calendar.
  startDate DateTime?
  dueDate   DateTime?

  members         PursuitMember[]
  pursuitTags     PursuitTag[]
  brainDumps      BrainDump[]
  notes           Note[]
  tags            Tag[]
  attachments     Attachment[]
  flashcards      Flashcard[]
  contentSections PursuitContentSection[]
  projects        Project[]
  tasks           Task[]
  choices         Choice[]
  budgetLines     BudgetLine[]
  expenses        Expense[]
  dateOptions     DateOption[]
  savings         Saving[]
  whiteboards     Whiteboard[]
  conceptMaps     ConceptMap[]
  challenges      Challenge[]
  calendarEvents  CalendarEvent[]
}

// Units inside one subject ("UD1", "UD2"), shared by its pages and notes so
// organizing a page keeps its unit. Section, by contrast, groups subjects.
model PursuitContentSection {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])

  brainDumps BrainDump[]
  notes      Note[]
  maps       ConceptMap[]
  events     CalendarEvent[]

  // The Classroom unit this unit maps to ("UD2"), matched against file
  // names, so the slide picker only shows that unit's slides.
  classroomUnit String?

  @@unique([pursuitId, name])
}

// A deliverable inside a subject ("Activity booklet, unit 3") with its own
// Kanban board.
model Project {
  id        String    @id @default(cuid())
  title     String
  // The assignment text, if one was uploaded.
  briefText String?
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])

  cards ProjectCard[]
}

enum ProjectCardStatus {
  TODO
  IN_PROGRESS
  DONE
}

model ProjectCard {
  id          String            @id @default(cuid())
  title       String
  description String?
  status      ProjectCardStatus @default(TODO)
  // Position within its status column (see reorderProjectCards).
  order       Int               @default(0)
  createdAt   DateTime          @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// A project's to-do: on the folder, its notebook's board and the home page.
model Task {
  id        String            @id @default(cuid())
  title     String
  status    ProjectCardStatus @default(TODO)
  // Position within its status column.
  order     Int               @default(0)
  // Optional: with a start the task spans start → dueDate on the Gantt chart.
  startDate DateTime?
  dueDate   DateTime?
  doneAt    DateTime?
  createdAt DateTime          @default(now())

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id], onDelete: Cascade)

  @@index([pursuitId, status])
}

// Who else (besides the owner) can see/edit a shared Pursuit, and at what level.
model PursuitMember {
  id        String     @id @default(cuid())
  role      MemberRole @default(EDITOR)
  invitedAt DateTime   @default(now())

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([pursuitId, userId])
}

// A user's grouping of subjects ("School", "Work"), shown as home tiles.
// A subject is in at most one Section.
model Section {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)
  // Cover texture key (lib/covers.ts); null = picked from the id.
  cover String?
  // Study tools (flashcards, review, maps, challenges) for its subjects.
  study Boolean @default(true)
  // Template it was made with: "study" | "projects" | "general" (null: from study).
  kind  String?
  // Tabs to sort its folders into ("Teoría", "Prácticas"…), in order.
  groups String[] @default([])
  // Its own page blocks under the folders (lib/blocks.ts NotebookBlock).
  blocks Json?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  pursuits Pursuit[]

  @@unique([userId, name])
}

// High-level labels on a Pursuit itself (e.g. #portfolio, #web-dev).
// Global to the user, not scoped per-pursuit — see schema notes on why.
model PursuitTag {
  id   String @id @default(cuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  pursuits Pursuit[]

  @@unique([userId, name])
}

// Raw, unstructured capture: text and/or images, zero required structure.
model BrainDump {
  id        String   @id @default(cuid())
  content   String?
  images    String[] @default([])
  processed Boolean  @default(false)
  // When it was last turned into its organized note; edited after this =
  // the ✦ button glows to add what's new.
  organizedAt DateTime?
  createdAt DateTime @default(now())
  // Optimistic concurrency for simultaneous editors (see updateBrainDump).
  updatedAt DateTime @updatedAt

  // Generated by Postgres from `content` (hand-written migration); read only
  // through $queryRaw in lib/search.ts.
  searchVector Unsupported("tsvector")?

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  // Who last touched each line, aligned with content.split("\n"). Recomputed on
  // save (lib/lineAuthors.ts); [] for old pages.
  lineAuthorIds String[] @default([])

  sectionId    String?
  section      PursuitContentSection? @relation(fields: [sectionId], references: [id])
  // Position within its section (see reorderDumpSection).
  sectionOrder Int                    @default(0)

  notes       Note[]
  attachments Attachment[]

  @@index([searchVector], type: Gin)
}

// AI-organized, structured writeup synthesized from one or more BrainDumps.
model Note {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  // Same optimistic-concurrency guard as BrainDump.updatedAt — Organized
  // notes are exactly where two collaborators editing at once actually
  // happened (see updateNote).
  updatedAt DateTime @updatedAt

  searchVector Unsupported("tsvector")?

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])

  // Kept from its source pages when they all shared one section.
  sectionId    String?
  section      PursuitContentSection? @relation(fields: [sectionId], references: [id])
  // Same idea as BrainDump.sectionOrder — set past the current max
  // whenever this note is dragged into a section.
  sectionOrder Int                    @default(0)

  sourceDumps BrainDump[]
  tags        Tag[]
  flashcards  Flashcard[]

  @@index([searchVector], type: Gin)
}

// Granular topic tags on Notes, scoped per-Pursuit (kept separate from
// PursuitTag on purpose — see the conversation notes on why).
model Tag {
  id   String @id @default(cuid())
  name String

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])

  notes Note[]

  @@unique([pursuitId, name])
}

// AI calls per user per UTC day (lib/organizeLimit.ts).
model OrganizeUsage {
  id    String   @id @default(cuid())
  date  DateTime
  count Int      @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

// A question/answer pair with SM-2 spaced-repetition state (lib/sm2.ts).
model Flashcard {
  id          String   @id @default(cuid())
  question    String
  answer      String
  createdAt   DateTime @default(now())
  interval    Int      @default(0)
  easeFactor  Float    @default(2.5)
  repetitions Int      @default(0)
  dueDate     DateTime @default(now())
  // Last time it was reviewed; counts toward the daily cap.
  reviewedAt  DateTime?
  // Three plausible wrong answers for multiple choice, written by the AI in
  // the same style as the answer. [] until generated.
  distractors String[] @default([])
  // A vague nudge for when you're stuck; never the answer itself.
  hint        String?
  // The quiz shows short versions: the question in a few words and a 2-6
  // word answer, matched by the distractors. Null until generated.
  quizQuestion String?
  quizAnswer   String?
  // And a true/false version: a short statement and whether it's true.
  tfStatement  String?
  tfTrue       Boolean?

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])

  // A flashcard outlives the note it was generated from — deleting or
  // re-organizing the note shouldn't delete cards you're already
  // reviewing, so this just goes null instead of cascading.
  noteId String?
  note   Note?   @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([pursuitId, dueDate])
}

// Loose reference files that just live in a Pursuit — no AI pipeline involved.
model Attachment {
  id        String   @id @default(cuid())
  url       String
  name      String
  size      Int
  createdAt DateTime @default(now())

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])

  // The page this file belongs to; null for files on the subject itself.
  dumpId String?
  dump   BrainDump? @relation(fields: [dumpId], references: [id], onDelete: SetNull)
}

// ─── Internalize ───
// A source (text/code, PDF, PowerPoint, notes, GitHub repo) broken into small
// concepts you explore in any order, explain back, and track. Concepts link
// to each other and can be split further ("go deeper" creates children).

enum ConceptStatus {
  NEW
  SEEN
  REREAD
  UNDERSTOOD
  MASTERED
}

model ConceptMap {
  id         String   @id @default(cuid())
  title      String
  // "text" | "pdf" | "notes" | "repo" — where the material came from.
  sourceKind String
  // Repo URL / file name, for display.
  sourceRef  String?
  // The material itself, capped, so "go deeper" and "ask" can answer
  // from the real source instead of from memory.
  sourceText String
  language   String   @default("English")
  createdAt  DateTime @default(now())

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id], onDelete: Cascade)

  // The unit (group) this map belongs to, if any.
  unitId String?
  unit   PursuitContentSection? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  concepts Concept[]
}

model Concept {
  id          String        @id @default(cuid())
  title       String
  summary     String
  explanation String
  // The word or phrase as it's written in the notes ("PreparedStatement"),
  // so a note can mark it and link it here. null for older concepts.
  term        String?
  // A verbatim piece of the source this concept is about (code or text),
  // and where it's from (file path, page). Only kept when it really
  // appears in the source.
  excerpt     String?
  excerptFrom String?
  // Learning-path position among its siblings.
  order       Int           @default(0)
  depth       Int           @default(0)
  status      ConceptStatus @default(NEW)
  statusAt    DateTime?
  // Your last "explain it back" attempt and what the AI said about it.
  attempt     String?
  feedback    String?
  createdAt   DateTime      @default(now())

  mapId String
  map   ConceptMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Concept?  @relation("ConceptTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Concept[] @relation("ConceptTree")

  linksOut ConceptLink[] @relation("LinkFrom")
  linksIn  ConceptLink[] @relation("LinkTo")

  @@index([mapId, order])
}

// "from" is needed to understand "to" (a prerequisite), unless label
// says otherwise ("related", "uses"…).
model ConceptLink {
  id    String  @id @default(cuid())
  label String?

  fromId String
  from   Concept @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     Concept @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

// ─── Coding challenges ────────────────────────────────────────────────
// A small exercise with tests that run in the browser. Optional subject.

model Challenge {
  id          String    @id @default(cuid())
  title       String
  prompt      String
  // "javascript" | "python"
  language    String
  // Name of the function the tests call.
  entry       String
  starterCode String
  // JSON: [{ "args": [...], "expected": ... }]
  tests       Json
  difficulty  String    @default("easy")
  // The skill it trains ("recorrer una lista acumulando"), from the topic's
  // skill map; null for older challenges.
  skill       String?
  code        String?
  passed      Boolean   @default(false)
  solvedAt    DateTime?
  review      String?
  createdAt   DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pursuitId String?
  pursuit   Pursuit? @relation(fields: [pursuitId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ─── Arena ───
// A debate about a headline with an AI on the other side.
// messages: [{ role: "user" | "ai", text, fallacies? }].

// ─── Calendar ───
// Exams, tasks and anything else with a date. Deliverables come from
// Project.dueDate and Google events are read live, so neither is stored here.
model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  // "exam" | "task" | "event"
  kind      String   @default("event")
  // A day (allDay) or a moment.
  date      DateTime
  allDay    Boolean  @default(true)
  // When a timed event ends (null = no end time given).
  endDate   DateTime?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  // The copy in Google Calendar, when sending is on.
  googleEventId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pursuitId String?
  pursuit   Pursuit? @relation(fields: [pursuitId], references: [id], onDelete: SetNull)
  // An exam's unit: what it covers.
  unitId String?
  unit   PursuitContentSection? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

// Google Calendar, its own consent (like Classroom). What to bring in and
// send out is chosen by the user.
model GoogleCalendarConnection {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  // Show events from these calendars (ids); [] = the primary one.
  pull         Boolean  @default(true)
  calendarIds  String[] @default([])
  // Copy exams, deliverables and tasks into the primary calendar.
  push         Boolean  @default(true)
  // A 20-minute review block before each exam.
  reviewBlocks Boolean  @default(false)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// An option in an "Opciones" block of a folder (a flat, a flight…): a
// link, a price in cents, a state, and the members' votes.
model Choice {
  id        String   @id @default(cuid())
  pursuitId String
  pursuit   Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
  // The block it belongs to, by its id in Pursuit.blocks.
  blockId   String
  title     String
  url       String?
  // IDEA | VOTING | CHOSEN
  status    String   @default("IDEA")
  price     Int?
  // Optional columns (the block chooses which show): 1-5 stars, a day
  // "YYYY-MM-DD", a short note.
  rating    Int?
  date      String?
  note      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  votes     ChoiceVote[]

  @@index([pursuitId, blockId])
}

model ChoiceVote {
  choiceId String
  choice   Choice @relation(fields: [choiceId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([choiceId, userId])
}

// A line you add to a "Presupuesto" block: "Comida · 40 € × 4 días × 4".
// unit in cents; perPerson multiplies by the folder's people.
model BudgetLine {
  id        String  @id @default(cuid())
  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
  blockId   String
  label     String
  unit      Int     @default(0)
  days      Int     @default(1)
  perPerson Boolean @default(true)
  order     Int     @default(0)

  @@index([pursuitId, blockId])
}

// A folder template you saved ("Mudanza", "Regalo"…): the blocks of a
// folder and their settings, not their content.
model UserTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  blocks    Json
  createdAt DateTime @default(now())

  @@index([userId])
}

// "Gastos": who paid what (cents); split equally between the folder's people.
model Expense {
  id        String   @id @default(cuid())
  pursuitId String
  pursuit   Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
  blockId   String
  label     String
  amount    Int
  paidById  String
  paidBy    User     @relation(fields: [paidById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([pursuitId, blockId])
}

// "Fechas": a proposed day ("YYYY-MM-DD") and who can make it.
model DateOption {
  id        String     @id @default(cuid())
  pursuitId String
  pursuit   Pursuit    @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
  blockId   String
  day       String
  votes     DateVote[]

  @@index([pursuitId, blockId])
}

model DateVote {
  dateOptionId String
  dateOption   DateOption @relation(fields: [dateOptionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([dateOptionId, userId])
}

// "Meta de ahorro": a contribution (cents) towards the block's goal.
model Saving {
  id        String   @id @default(cuid())
  pursuitId String
  pursuit   Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
  blockId   String
  amount    Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([pursuitId, blockId])
}

// A whiteboard drawn inside a page (stored in the page as an image that
// points to /api/boards/<id>). data: lib/whiteboard.ts shapes.
model Whiteboard {
  id        String   @id @default(cuid())
  pursuitId String
  pursuit   Pursuit  @relation(fields: [pursuitId], references: [id], onDelete: Cascade)
  data      Json     @default("[]")
  updatedAt DateTime @updatedAt
}

// A friend request from one user to another; ACCEPTED makes them friends
// both ways.
model Friendship {
  id        String       @id @default(cuid())
  fromId    String
  from      User         @relation("FriendFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User         @relation("FriendTo", fields: [toId], references: [id], onDelete: Cascade)
  status    FriendStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@unique([fromId, toId])
  @@index([toId])
}

enum FriendStatus {
  PENDING
  ACCEPTED
}

// A test kept to take again: a quiz (multiple choice, the questions as they
// were) or a final test (written answers the AI marks). Scoped to a folder
// (and unit) or everything.
model SavedTest {
  id        String   @id @default(cuid())
  title     String
  kind      String   @default("quiz") // "quiz" | "final"
  pursuitId String?
  unitId    String?
  items     Json
  total     Int
  attempts  Int      @default(0)
  lastScore Int?
  bestScore Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── Unificar con Drive (lib/driveAgent.ts) ────────────────────────────
// A small Apps Script in the student's own Google account does the Drive
// work (it can, where a school blocks third-party apps); Synaptic decides
// where each file goes, shows the plan, keeps the log and the undo.

// The student's script: how it signs in (hash of its token), when it last
// called, and the naming rules (lib/materialName.ts NamingConfig plus
// per-file overrides).
model DriveAgent {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  config     Json?
  // Apply new files on their own once the first plan was approved.
  autoApply  Boolean   @default(false)
  // Phase e: how the script found files last time — "classroom" (the API
  // works) or "gmail" (blocked: Classroom emails and class folders) — and
  // what it saw: { courses, gmail, error }.
  mode       String?
  stats      Json?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A file the script found (by its Drive id) and what to do with it.
// status: "review" (Synaptic can't tell where it goes) | "planned" (waits
// for approval) | "approved" | "done" | "skipped" | "error".
model DriveSource {
  id        String   @id @default(cuid())
  sourceId  String
  name      String
  mimeType  String?
  // When the original was made: the newer one wins a slot.
  createdAt DateTime
  // The Classroom course or class folder it came from (a name), and the
  // post or assignment title (it may say the unit).
  course    String?
  hint      String?
  // { kind, subject, folder: [..], name, pdf } from placeMaterial, or null.
  placement Json?
  reason    String?
  status    String   @default("planned")
  outputId  String?
  error     String?
  // Phase d: a topic's text (from Drive, for the AI), the page made from it,
  // and whether that page is "pending" | "done" | "error" | "skipped".
  text       String?
  noteId     String?
  pageStatus String?
  pageError  String?
  seenAt    DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId])
  @@index([userId, status])
  @@index([userId, pageStatus])
}

// Every change the script made, to show and to undo. action: "create" (a
// new file) | "replace" (new file; oldId went to the bin) | "trash".
// undo: "requested" → the script does it → "done".
model DriveChange {
  id        String   @id @default(cuid())
  runId     String
  action    String
  path      String
  fileId    String
  oldId     String?
  sourceId  String?
  undo      String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
