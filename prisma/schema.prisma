// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Auth (NextAuth.js / Auth.js Prisma adapter shape) ──────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Billing — set from the Stripe webhook (src/app/api/webhooks/stripe),
  // never written directly from a page or action, so this always reflects
  // what Stripe itself thinks the subscription state is rather than
  // something the app guessed right after a checkout redirect.
  plan                   Plan      @default(FREE)
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripeCurrentPeriodEnd DateTime?

  accounts Account[]
  sessions Session[]

  ownedPursuits Pursuit[]
  memberships   PursuitMember[]
  pursuitTags   PursuitTag[]
  sections      Section[]
  brainDumps    BrainDump[]
  organizeUsage OrganizeUsage[]

  classroomConnection GoogleClassroomConnection?
  pushSubscriptions   PushSubscription[]
  sentNotifications   SentDeadlineNotification[]
}

enum Plan {
  FREE
  PRO
  TEAM
}

// A separate OAuth connection from the NextAuth Google sign-in Account
// row on purpose — logging in with Google and connecting Classroom are
// different consents (this one asks for Classroom/Drive read access,
// which most sign-ins never need), and someone who signs in with GitHub
// can still connect Classroom. accessToken is short-lived and refreshed
// via refreshToken on demand (see lib/googleClassroom.ts) rather than on
// a schedule, since it's only needed when the Files tab actually asks.
model GoogleClassroomConnection {
  id           String   @id @default(cuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per browser/device a user enabled deadline reminders on (the
// Web Push standard ties a subscription to a specific browser push
// endpoint, not to an account) — a user signed in on phone and laptop
// gets two rows, and both receive the reminder.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Dedupes the deadline-reminder cron: courseWorkId is Classroom's own id
// for the assignment, so the unique constraint means "already notified
// this user about this specific deadline" without needing to compare
// dates/titles across runs.
model SentDeadlineNotification {
  id           String   @id @default(cuid())
  courseWorkId String
  sentAt       DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseWorkId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Core app models ─────────────────────────────────────────────────────

enum PursuitStatus {
  ACTIVE
  PAUSED
  DONE
}

enum MemberRole {
  OWNER
  EDITOR
  VIEWER
}

model Pursuit {
  id            String        @id @default(cuid())
  title         String
  // Free-typed and optional, same as Section — a fixed Project/Book/
  // Language/Skill/Other dropdown was one more required, rigid axis of
  // categorization alongside Section and PursuitTag, which are both
  // already free-typed and optional.
  type          String?
  status        PursuitStatus @default(ACTIVE)
  artifactUrl   String?
  lastTouchedAt DateTime      @default(now())
  createdAt     DateTime      @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  sectionId String?
  section   Section? @relation(fields: [sectionId], references: [id])

  // Which Google Classroom course (if any) this Pursuit is linked to, set
  // by picking a course in the Files tab's Classroom import — lets the
  // upcoming-deadlines widget know which course's courseWork to read
  // without asking the user to pick it again every visit. courseName is
  // cached alongside the id purely so the UI has something to show before
  // the Classroom API round trip resolves.
  classroomCourseId   String?
  classroomCourseName String?
  // Opt-in per Pursuit, off by default — Classroom only makes sense for
  // a school subject, not a book/project/language pursuit, and type is
  // free-typed text (not a fixed enum), so this can't be inferred from
  // it reliably. Toggled from the Files tab.
  classroomEnabled    Boolean @default(false)

  members     PursuitMember[]
  pursuitTags PursuitTag[]
  brainDumps  BrainDump[]
  notes       Note[]
  tags        Tag[]
  attachments Attachment[]
  flashcards  Flashcard[]
}

// Who else (besides the owner) can see/edit a shared Pursuit, and at what level.
model PursuitMember {
  id        String     @id @default(cuid())
  role      MemberRole @default(EDITOR)
  invitedAt DateTime   @default(now())

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([pursuitId, userId])
}

// A user-created grouping for the Pursuits list ("Projects", "Trabajo"…),
// shown as a horizontally-scrollable row. Unlike PursuitTag (many tags per
// Pursuit), a Pursuit sits in at most one Section at a time — it's a bucket,
// not a label. Global to the user and free-typed, same as PursuitTag, so
// there's no fixed preset list to pick from.
model Section {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  pursuits Pursuit[]

  @@unique([userId, name])
}

// High-level labels on a Pursuit itself (e.g. #portfolio, #web-dev).
// Global to the user, not scoped per-pursuit — see schema notes on why.
model PursuitTag {
  id   String @id @default(cuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  pursuits Pursuit[]

  @@unique([userId, name])
}

// Raw, unstructured capture: text and/or images, zero required structure.
model BrainDump {
  id        String   @id @default(cuid())
  content   String?
  images    String[] @default([])
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  // Postgres-generated column (see the hand-written migration): recomputed
  // automatically by the database whenever `content` changes, so full-text
  // search never has to re-tokenize the text at query time. Prisma doesn't
  // model tsvector natively, hence Unsupported — it's read only through
  // $queryRaw in lib/search.ts, never through the normal Client API.
  searchVector Unsupported("tsvector")?

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  notes Note[]

  @@index([searchVector], type: Gin)
}

// AI-organized, structured writeup synthesized from one or more BrainDumps.
model Note {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  searchVector Unsupported("tsvector")?

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])

  sourceDumps BrainDump[]
  tags        Tag[]
  flashcards  Flashcard[]

  @@index([searchVector], type: Gin)
}

// Granular topic tags on Notes, scoped per-Pursuit (kept separate from
// PursuitTag on purpose — see the conversation notes on why).
model Tag {
  id   String @id @default(cuid())
  name String

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])

  notes Note[]

  @@unique([pursuitId, name])
}

// One row per (user, UTC day) — tracks how many times Organize has
// actually called the AI that day, to cap Groq usage per user without
// any external rate-limiting service. See lib/organizeLimit.ts for the
// check-then-increment logic that reads/writes this.
model OrganizeUsage {
  id    String   @id @default(cuid())
  date  DateTime
  count Int      @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

// A generated question/answer pair with its own SM-2 spaced-repetition
// state (see lib/sm2.ts for the algorithm) — interval/easeFactor/
// repetitions are the three numbers SM-2 needs to remember between
// reviews, and dueDate is just interval days added to the last review
// (or creation, before the first one).
model Flashcard {
  id          String   @id @default(cuid())
  question    String
  answer      String
  createdAt   DateTime @default(now())
  interval    Int      @default(0)
  easeFactor  Float    @default(2.5)
  repetitions Int      @default(0)
  dueDate     DateTime @default(now())

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])

  // A flashcard outlives the note it was generated from — deleting or
  // re-organizing the note shouldn't delete cards you're already
  // reviewing, so this just goes null instead of cascading.
  noteId String?
  note   Note?   @relation(fields: [noteId], references: [id], onDelete: SetNull)

  @@index([pursuitId, dueDate])
}

// Loose reference files that just live in a Pursuit — no AI pipeline involved.
model Attachment {
  id        String   @id @default(cuid())
  url       String
  name      String
  size      Int
  createdAt DateTime @default(now())

  pursuitId String
  pursuit   Pursuit @relation(fields: [pursuitId], references: [id])
}
